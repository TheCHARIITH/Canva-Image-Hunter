{
  "manifest_version": 3,
  "name": "Canva Image Hunter",
  "description": "Reliably show, copy, and download images from every frame, shadow DOM, and lazy loads.",
  "version": "1.2.0",
  "action": { "default_popup": "popup.html", "default_title": "Canva Image Hunter" },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "notifications",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}